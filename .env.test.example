# Copy to .env.test.local. Keep credentials quoted; this file is only read by
# the local acceptance client, which sends normal API request headers.
PYROMIND_TEST_COOKIE=''
PYROMIND_TEST_X_CLUSTER=''
# Optional: numeric account ID for the existing APP_ENV=dev debug identity.
PYROMIND_TEST_USER_ID=''
PYROMIND_TEST_AGENT_URL='http://127.0.0.1:8000'
PYROMIND_TEST_SESSION_API_KEY='pyromind_agent'

# Real Storage paths for a small baseline (no training/deployment is requested).
PYROMIND_TEST_MODEL_PATH=''
PYROMIND_TEST_DATA_PATH=''
PYROMIND_TEST_SAMPLE_LIMIT='4'
# Optional model overrides; leave blank to use the running server's configuration.
PYROMIND_TEST_LLM_MODEL=''
PYROMIND_TEST_LLM_BASE_URL=''
PYROMIND_TEST_LLM_API_KEY=''
